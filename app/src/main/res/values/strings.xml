    <!-- Privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">A keyboard sees every password and message you type. CorkKeys is built so that nothing you type leaves the phone, and nothing is kept unless you turn it on here.</string>
    <string name="privacy_switches">Off until you turn them on</string>
    <string name="privacy_incognito">Incognito</string>
    <string name="privacy_incognito_sub">Learning stays off everywhere until you switch this back. Also in the long-press space menu; the space bar shows it while it\'s on.</string>
    <string name="privacy_facts">What CorkKeys can\'t do</string>
    <string name="privacy_fact_network">It has no internet permission, so Android blocks every network connection it could try to make.</string>
    <string name="privacy_fact_stored">Nothing you type is written anywhere. The word you are typing lives in memory until it goes into the app, then it\'s gone.</string>
    <string name="privacy_fact_passwords">Password fields get no suggestions, no autocorrect, no swipe, no key bubbles and no learning.</string>
    <string name="privacy_fact_clipboard">The clipboard is touched only when you press Paste, and normally the app pastes without the keyboard seeing the text. No clipboard history.</string>
    <string name="privacy_fact_backup">Nothing goes into Android\'s cloud backup or device-to-device transfer.</string>
    <string name="privacy_fact_logs">No logging, no crash reporter, no analytics.</string>
    <string name="privacy_permissions">Permissions</string>
    <string name="privacy_permissions_none">None. CorkKeys asks Android for no permissions at all.</string>
    <string name="privacy_read_more">Read the full privacy notes</string>
</resources>
