    <string name="privacy_title">Privacidad</string>
    <string name="privacy_intro">Un teclado ve cada contraseña y cada mensaje que escribes. CorkKeys está hecho para que nada de lo que escribes salga del teléfono y no se guarde nada salvo que lo actives aquí.</string>
    <string name="privacy_switches">Desactivados hasta que los actives</string>
    <string name="privacy_incognito">Incógnito</string>
    <string name="privacy_incognito_sub">El aprendizaje queda desactivado en todas partes hasta que lo vuelvas a quitar. También en el menú al mantener pulsado el espacio; la barra espaciadora lo indica mientras está activo.</string>
    <string name="privacy_facts">Lo que CorkKeys no puede hacer</string>
    <string name="privacy_fact_network">No tiene permiso de internet, así que Android bloquea cualquier conexión de red que intente.</string>
    <string name="privacy_fact_stored">Nada de lo que escribes se guarda en ningún sitio. La palabra que estás escribiendo vive en memoria hasta que entra en la app y después desaparece.</string>
    <string name="privacy_fact_passwords">Los campos de contraseña no tienen sugerencias, autocorrección, deslizamiento, burbujas de tecla ni aprendizaje.</string>
    <string name="privacy_fact_clipboard">El portapapeles solo se toca al pulsar Pegar y, normalmente, la app pega sin que el teclado vea el texto. Sin historial del portapapeles.</string>
    <string name="privacy_fact_backup">Nada va a la copia de seguridad en la nube de Android ni a la transferencia entre dispositivos.</string>
    <string name="privacy_fact_logs">Sin registros, sin informes de fallos, sin analíticas.</string>
    <string name="privacy_permissions">Permisos</string>
    <string name="privacy_permissions_none">Ninguno. CorkKeys no pide ningún permiso a Android.</string>
    <string name="privacy_read_more">Leer las notas completas de privacidad</string>
